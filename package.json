    "webhook",
    "webhooks",
    "stripe",
    "shopify",
    "github",
    "clerk",
    "svix",
    "signature",
    "hmac",
    "idempotency",
    "nestjs",
    "nextjs",
    "verification"
  ],
  "license": "MIT",
  "author": "Muhammad Afan",
  "repository": {
